9:["$","$La",null,{"locale":"ru","now":"$D2026-05-23T17:32:16.148Z","timeZone":"Asia/Tehran","messages":{"metadata":{"title":"SIPANEL | Инжиниринг промышленных ограждающих систем","description":"Промышленные ограждающие системы с инженерным контролем проектирования, поставки и монтажа."},"nav":{"home":"Главная","systems":"Системы","projects":"Проекты","process":"Процесс","about":"О компании","resources":"Ресурсы","contact":"Контакты"},"header":{"selectLanguage":"Выбрать язык","menu":"Меню","phone":"+98 31 3675 1101","email":"info@sipanelco.ir","cta":"Получить инженерную оценку"},"footer":{"navigationLabel":"Навигация в подвале","systems":"Системы","projects":"Проекты","resources":"Ресурсы","company":"Компания","contact":"Контакты"},"proofSnapshot":{"eyebrow":"Инженерное подтверждение","title":"Технический контроль до монтажа","pendingAsset":"Ожидается реальный технический материал","viewerPending":"Полноэкранный просмотр подготовлен для будущего технического материала","cards":{"shopDrawing":{"title":"Точность рабочих чертежей","proof":"Раскладка панелей, логика соединений и последовательность монтажа проверяются до выполнения работ.","visualLabel":"Раскладка"},"waterproofing":{"title":"Логика гидроизоляции","proof":"Водоотвод, фартуки, нахлесты и кровельные узлы проектируются для снижения риска протечек.","visualLabel":"Водоотвод"},"materialOptimization":{"title":"Оптимизация материалов","proof":"Поставка планируется на основе точных объемов, снижения отходов и контроля стоимости проекта.","visualLabel":"BOM контроль"}}},"stickyCta":{"label":"Мобильное действие по проекту","primary":"Получить инженерную оценку","whatsapp":"WhatsApp"},"process":{"title":"Инжиниринг → Поставка → Монтаж","steps":{"engineeringReview":{"title":"Инженерная проверка","description":"Чертежи проекта, ограничения площадки, требования системы и риски протечек проверяются до поставки."},"smartProcurement":{"title":"Умная поставка","description":"Количество панелей, аксессуары, фартуки и материалы проекта планируются для снижения отходов и задержек."},"controlledInstallation":{"title":"Контролируемый монтаж","description":"Монтаж следует согласованной последовательности, техническим деталям и инспекционному контролю качества."},"finalVerification":{"title":"Финальная проверка","description":"Готовая система проверяется по качеству монтажа, деталям гидроизоляции и требованиям проекта."}}},"caseStudies":{"eyebrow":"Проектное подтверждение","title":"Кейсы с измеримым инженерным контекстом","cta":"Смотреть выполненные проекты","challenge":"Задача","engineeringDecision":"Инженерное решение","measuredResult":"Измеримый результат"},"comparison":{"title":"Поставка без инжиниринга и инженерно контролируемое выполнение","columns":{"supplyOnly":"Типичный подход поставки","sipanel":"Инженерно контролируемый подход SIPANEL"},"points":{"panelSelection":{"label":"Выбор панелей","typical":"Тип панели может выбираться в основном по наличию или цене, с ограниченной проверкой условий площадки.","sipanel":"Выбор панели проверяется по назначению здания, геометрии кровли, требованиям изоляции и рискам монтажа."},"waterproofingResponsibility":{"label":"Ответственность за гидроизоляцию","typical":"Узлы гидроизоляции могут оставаться на интерпретацию площадки во время монтажа.","sipanel":"Водоотвод, фартуки, нахлесты и логика герметизации согласуются до выполнения работ для снижения риска протечек."},"materialWaste":{"label":"Отходы материалов","typical":"Материалы могут заказываться до полной проработки раскладки панелей и аксессуаров.","sipanel":"Поставка следует согласованным раскладкам и планированию материалов для контроля отходов."},"installationCoordination":{"label":"Координация монтажа","typical":"Последовательность и выравнивание могут решаться монтажниками непосредственно на площадке.","sipanel":"Монтаж идет по запланированной последовательности, контрольным точкам выравнивания и согласованным техническим деталям."},"riskBeforeConstruction":{"label":"Риски до строительства","typical":"Риски проекта часто становятся видимыми после прибытия материалов или начала монтажа.","sipanel":"Ключевые риски проверяются до поставки, чтобы решения контролировались раньше."},"technicalDocumentation":{"label":"Техническая документация","typical":"Документация может ограничиваться информацией о продукте и базовыми инструкциями по монтажу.","sipanel":"Рабочие чертежи, узлы и логика поставки помогают яснее распределять ответственность при выполнении."}}},"resourcesPreview":{"title":"Технические ресурсы для лучших проектных решений","cta":"Скачать инженерный материал","pending":"Файл ресурса ожидает подготовки","types":{"guide":"Руководство","checklist":"Чек-лист"},"cards":{"panelSelection":{"title":"Руководство по выбору панелей","description":"Проверьте тип панели, сердечник, толщину, логику стыков, требования к изоляции и условия проекта до поставки."},"roofLeakage":{"title":"Чек-лист предотвращения протечек кровли","description":"Проверьте уклон, водоотвод, фартуки, проходки, желоба и риски монтажа до начала кровельных работ."},"shopDrawing":{"title":"Руководство по проверке рабочих чертежей","description":"Проверьте раскладку панелей, аксессуары, логику фартуков, объемы и координацию монтажа."}}},"rfq":{"eyebrow":"Запрос инженерной проверки","title":"Начните проект с уверенностью.","intro":"Отправьте данные проекта, чтобы SIPANEL проверила объем ограждающих систем, выбор системы, риски поставки и требования монтажа.","backendPending":"Интеграция backend ожидает подключения","stepsLabel":"Шаги формы RFQ","steps":{"0":"Контактные данные","1":"Объем проекта","2":"Технические данные"},"fields":{"name":"Полное имя","company":"Компания","phone":"Телефон","whatsapp":"WhatsApp","email":"Email","project_type":"Тип проекта","project_location":"Местоположение проекта","estimated_area":"Ориентировочная площадь","message":"Детали проекта","optional_file_upload":"Загрузить чертеж или файл проекта"},"projectTypes":{"sandwichPanel":"Системы сэндвич-панелей","standingSeam":"Кровля Standing Seam и ZIP Tech","aluminiumCladding":"Алюминиевый клаттинг и покрытия","fullEnvelope":"Полная промышленная оболочка","technicalReview":"Техническая проверка / консультация","other":"Другое"},"placeholders":{"select":"Выберите тип проекта"},"validation":{"required":"Это поле обязательно.","email":"Введите корректный email.","message":"Добавьте краткое техническое описание проекта.","fileSize":"Максимальный размер файла 10MB.","fileType":"Допустимые форматы: PDF, JPG, PNG, DWG.","spam":"Проверка защиты от спама не пройдена."},"contact":{"title":"Контактная информация SIPANEL","note":"Контакты отображаются только из настроенной производственной информации."},"fileHelp":"Необязательно. PDF, JPG, PNG или DWG до 10MB.","spamPlaceholder":"Заполнитель защиты от спама включен.","privacy":"Данные проекта используются только для инженерной проверки и обратной связи.","back":"Назад","next":"Далее","submit":"Запросить техническую консультацию","submitting":"Отправка запроса...","success":"Данные проекта прошли frontend-проверку.","error":"Backend endpoint пока не подключен. Frontend-структура RFQ готова к интеграции."},"hero":{"eyebrow":"Engineering Power. Controlled Execution.","headline":"Снижайте риски проекта до начала строительства.","subheadline":"Точные рабочие чертежи, контролируемая поставка и инженерные системы монтажа для промышленных зданий.","primaryCta":"Получить инженерную оценку","secondaryCta":"Запросить проверку стоимости","visualAlt":"Промышленный проект SIPANEL с инженерными системами кровли и фасада","proofValue":"Инжиниринг","proofLabel":"Контроль качества"}},"children":[["$","$Lb",null,{"locale":"ru","dir":"ltr"}],"$Lc",["$","main",null,{"children":["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined",