24:["$","$L25",null,{"locale":"ar","now":"$D2026-05-23T17:32:16.340Z","timeZone":"Asia/Tehran","messages":{"metadata":{"title":"SIPANEL | هندسة أغلفة المباني الصناعية","description":"أنظمة أغلفة صناعية بمنهج هندسي للتحكم في التصميم والتوريد والتنفيذ."},"nav":{"home":"الرئيسية","systems":"الأنظمة","projects":"المشاريع","process":"المنهجية","about":"من نحن","resources":"الموارد","contact":"تواصل"},"header":{"selectLanguage":"اختيار اللغة","menu":"القائمة","phone":"+98 31 3675 1101","email":"info@sipanelco.ir","cta":"احصل على مراجعة هندسية مجانية"},"footer":{"navigationLabel":"تنقل التذييل","systems":"الأنظمة","projects":"المشاريع","resources":"الموارد","company":"الشركة","contact":"تواصل"},"proofSnapshot":{"eyebrow":"دليل هندسي","title":"تحكم فني قبل التنفيذ","pendingAsset":"بانتظار أصل فني حقيقي","viewerPending":"عارض ملء الشاشة جاهز لأصل فني مستقبلي","cards":{"shopDrawing":{"title":"دقة الرسومات التنفيذية","proof":"تتم مراجعة توزيع الألواح ومنطق التوصيل وتسلسل التركيب قبل التنفيذ.","visualLabel":"توزيع الألواح"},"waterproofing":{"title":"منطق العزل المائي","proof":"تتم هندسة التصريف والفلاشينغ والتراكب وتفاصيل السقف لتقليل مخاطر التسرب.","visualLabel":"مسار التصريف"},"materialOptimization":{"title":"تحسين المواد","proof":"يتم تخطيط التوريد وفق كميات دقيقة وتقليل الهدر وضبط تكلفة المشروع.","visualLabel":"تحكم BOM"}}},"stickyCta":{"label":"إجراء المشروع على الجوال","primary":"احصل على مراجعة هندسية","whatsapp":"واتساب"},"process":{"title":"الهندسة ← التوريد ← التنفيذ","steps":{"engineeringReview":{"title":"المراجعة الهندسية","description":"تتم مراجعة رسومات المشروع وقيود الموقع ومتطلبات النظام ومخاطر التسرب قبل التوريد."},"smartProcurement":{"title":"توريد ذكي","description":"يتم تخطيط كميات الألواح والملحقات والفلاشينغ ومواد المشروع لتقليل الهدر والتأخير."},"controlledInstallation":{"title":"تركيب مضبوط","description":"يتبع التنفيذ تسلسلات منسقة وتفاصيل فنية ورقابة جودة قائمة على الفحص."},"finalVerification":{"title":"التحقق النهائي","description":"يتم فحص النظام المسلم وفق جودة التنفيذ وتفاصيل العزل المائي ومتطلبات المشروع."}}},"caseStudies":{"eyebrow":"إثبات المشاريع","title":"دراسات حالة بسياق هندسي قابل للقياس","cta":"استكشف المشاريع المثبتة","challenge":"التحدي","engineeringDecision":"القرار الهندسي","measuredResult":"النتيجة المقاسة"},"comparison":{"title":"التوريد فقط مقابل التنفيذ الهندسي المضبوط","columns":{"supplyOnly":"نهج التوريد فقط المعتاد","sipanel":"نهج SIPANEL الهندسي المضبوط"},"points":{"panelSelection":{"label":"اختيار الألواح","typical":"قد يتم اختيار نوع اللوح بناء على التوفر أو السعر مع مراجعة محدودة لقيود الموقع.","sipanel":"يتم فحص اختيار اللوح مقابل استخدام المبنى وهندسة السقف واحتياجات العزل ومخاطر التنفيذ."},"waterproofingResponsibility":{"label":"مسؤولية العزل المائي","typical":"قد تترك تفاصيل العزل المائي لتفسير الموقع أثناء التركيب.","sipanel":"تتم مواءمة التصريف والفلاشينغ والتراكب ومنطق الإغلاق قبل التنفيذ لتقليل مخاطر التسرب."},"materialWaste":{"label":"هدر المواد","typical":"قد تطلب الكميات قبل حسم توزيع الألواح وتنسيق الملحقات بالكامل.","sipanel":"يتبع التوريد مخططات منسقة وتخطيطا للمواد لدعم التحكم في الهدر."},"installationCoordination":{"label":"تنسيق التركيب","typical":"قد يعالج فريق التركيب التسلسل ومشكلات المحاذاة مباشرة في الموقع.","sipanel":"يتبع التركيب تسلسلا مخططا ونقاط تحقق للمحاذاة وتفاصيل فنية منسقة."},"riskBeforeConstruction":{"label":"المخاطر قبل البناء","typical":"تظهر مخاطر المشروع غالبا بعد وصول المواد أو بدء التركيب.","sipanel":"تراجع المخاطر الرئيسية قبل التوريد حتى يمكن التحكم في القرارات مبكرا."},"technicalDocumentation":{"label":"المستندات الفنية","typical":"قد تقتصر المستندات على معلومات المنتج وإرشادات تركيب أساسية.","sipanel":"تدعم الرسومات التنفيذية والتفاصيل ومنطق التوريد وضوح المسؤولية أثناء التنفيذ."}}},"resourcesPreview":{"title":"موارد فنية لقرارات مشروع أفضل","cta":"تنزيل المورد الهندسي","pending":"ملف المورد بانتظار الإعداد","types":{"guide":"دليل","checklist":"قائمة تحقق"},"cards":{"panelSelection":{"title":"دليل اختيار الألواح","description":"افهم نوع اللوح واختيار القلب والسماكة ومنطق الوصل واحتياجات العزل وظروف المشروع قبل التوريد."},"roofLeakage":{"title":"قائمة منع تسرب السقف","description":"راجع الميل والتصريف والفلاشينغ والاختراقات والمزاريب ومخاطر التركيب قبل بدء أعمال السقف."},"shopDrawing":{"title":"دليل مراجعة الرسومات التنفيذية","description":"تحقق من توزيع الألواح والملحقات ومنطق الفلاشينغ والكميات وتنسيق التنفيذ قبل التركيب."}}},"rfq":{"eyebrow":"طلب مراجعة هندسية","title":"ابدأ مشروعك بثقة.","intro":"أرسل تفاصيل المشروع حتى تراجع SIPANEL نطاق الغلاف واختيار النظام ومخاطر التوريد ومتطلبات التنفيذ.","backendPending":"تكامل الواجهة الخلفية قيد الانتظار","stepsLabel":"خطوات نموذج RFQ","steps":{"0":"بيانات التواصل","1":"نطاق المشروع","2":"التفاصيل الفنية"},"fields":{"name":"الاسم الكامل","company":"الشركة","phone":"الهاتف","whatsapp":"واتساب","email":"البريد الإلكتروني","project_type":"نوع المشروع","project_location":"موقع المشروع","estimated_area":"المساحة التقديرية","message":"تفاصيل المشروع","optional_file_upload":"رفع رسم أو ملف مشروع"},"projectTypes":{"sandwichPanel":"أنظمة الساندويتش بانل","standingSeam":"أسقف Standing Seam و ZIP Tech","aluminiumCladding":"الألمنيوم كلادينغ والتغطيات","fullEnvelope":"غلاف صناعي كامل","technicalReview":"مراجعة فنية / استشارة","other":"أخرى"},"placeholders":{"select":"اختر نوع المشروع"},"validation":{"required":"هذا الحقل مطلوب.","email":"أدخل بريدا إلكترونيا صحيحا.","message":"أضف وصفا فنيا قصيرا للمشروع.","fileSize":"الحد الأقصى لحجم الملف 10MB.","fileType":"الصيغ المسموحة: PDF، JPG، PNG، DWG.","spam":"فشل فحص الحماية من الرسائل المزعجة."},"contact":{"title":"معلومات التواصل مع SIPANEL","note":"تظهر بيانات التواصل فقط من معلومات الإنتاج الموثقة."},"fileHelp":"اختياري. PDF أو JPG أو PNG أو DWG حتى 10MB.","spamPlaceholder":"تم تفعيل عنصر حماية من الرسائل المزعجة.","privacy":"تستخدم تفاصيل مشروعك فقط للمراجعة الهندسية والمتابعة.","back":"السابق","next":"التالي","submit":"اطلب استشارة فنية","submitting":"جار إرسال الطلب...","success":"اجتازت تفاصيل المشروع تحقق الواجهة الأما