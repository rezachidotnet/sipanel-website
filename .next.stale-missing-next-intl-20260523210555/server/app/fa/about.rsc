0:["PVIDsC-fCqLnX5j5vwe-z",[[["",{"children":[["locale","fa","d"],{"children":["about",{"children":["__PAGE__?{\"locale\":\"fa\"}",{}]}]},"$undefined","$undefined",true]}],["",{"children":[["locale","fa","d"],{"children":["about",{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"locale":"fa","page":{"routes":{"en":"/en/about","fa":"/fa/about","ar":"/ar/about","ru":"/ru/about"},"contact":{"company_name":"SIPANEL","address":"No. 6, Azadegan Alley, Hezar Jerib Blvd, Isfahan, Iran","phone":"+98 31 3675 1101","whatsapp":"+98 912 065 66528","email":"info@sipanelco.ir","website":"https://www.sipanelco.ir"},"localeContent":{"en":{"seo":{"title":"About SIPANEL | Industrial Envelope Engineering & Controlled Execution","metaDescription":"Learn how SIPANEL helps industrial projects reduce execution risk through engineering review, smart procurement, waterproofing logic, and controlled installation systems.","h1":"Engineering-Controlled Industrial Envelope Systems."},"hero":{"eyebrow":"About SIPANEL","h1":"Engineering-Controlled Industrial Envelope Systems.","subheadline":"SIPANEL helps industrial projects reduce leakage risk, material waste, coordination errors, and execution uncertainty through engineering review, smart procurement, and controlled installation.","primaryCta":"Request Technical Consultation","secondaryCta":"Explore Systems","trustMicrocopy":"Built around industrial execution control, not just material supply.","visualAlt":"Industrial SIPANEL project collage"},"conversionCta":{"headline":"Reduce Execution Risk Before Construction Begins.","text":"Request a technical consultation for your industrial panel, roofing, or cladding project.","primaryCta":"Request Technical Consultation","secondaryCta":"Contact via WhatsApp","contactHint":"Verified contact data only."},"stickyMobileCta":{"label":"Technical Consultation","secondaryAction":"WhatsApp"},"companyPositioning":{"title":"More Than Material Supply.","cards":[{"title":"Engineering Review","description":"SIPANEL reviews system logic, drainage, layout, waterproofing, and installation conditions before procurement and execution."},{"title":"Smart Procurement","description":"Quantities, accessories, flashings, trims, and materials are coordinated to reduce waste and avoid site delays."},{"title":"Controlled Installation","description":"Execution follows technical details, sequencing logic, inspection checkpoints, and engineering coordination."}]},"companyStory":{"title":"Why SIPANEL Exists","lead":"Industrial envelope problems usually begin long before installation: unclear drawings, weak system selection, poor sequencing, and unplanned coordination.","points":[{"title":"Problem in the market","description":"Projects often start with materials, not with a system review. That creates leakage risk, waste, and execution drift."},{"title":"Why execution fails","description":"When drawings, drainage logic, accessories, and site sequencing are not aligned, site teams spend time correcting avoidable issues."},{"title":"Why engineering matters","description":"Engineering review reduces uncertainty before procurement and installation, when changes are still inexpensive to make."},{"title":"How SIPANEL approaches projects","description":"SIPANEL works from system review to controlled installation so the project stays coordinated, measurable, and technically defensible."}],"visual":{"image":{"src":"/_next/static/media/andimeshk-hero-desktop.1affe320.webp","height":900,"width":1600,"blurDataURL":"data:image/webp;base64,UklGRlIAAABXRUJQVlA4IEYAAADQAQCdASoIAAUAAkA4JQBOgCKUZqV0AAD30zzq8f/sJ5Sr59HAbflE5hdL5yG+7aS0ILGTQ/JtmW9dtSiccCM4nDwJ4AAA","blurWidth":8,"blurHeight":5},"alt":"Industrial project engineering reference visual"}},"corePrinciples":{"title":"Core Execution Principles","principles":[{"title":"Engineering Before Installation","description":"Project risk should be reviewed before site execution begins."},{"title":"Waterproofing Logic Matters","description":"Drainage, flashings, overlaps, seams, and penetrations determine long-term roof performance."},{"title":"Layout Controls Quality","description":"Panel rhythm, facade alignment, and quantity planning affect execution quality and waste."},{"title":"Execution Needs Coordination","description":"Installation quality depends on sequencing, drawings, procurement, and inspection checkpoints."},{"title":"Technical Proof Over Claims","description":"Real details, diagrams, and execution proof matter more than marketing language."},{"title":"Industrial Projects Need Control","description":"Large industrial systems require planning, verification, and engineering discipline."}]},"systemsOverview":{"title":"Industrial Envelope Systems","systems":[{"title":"Sandwich Panel Systems","description":"Panel layout, insulation systems, accessories, flashing coordination, and installation control.","cta":"Explore Panel Systems","href":"/systems/sandwich-panel-systems"},{"title":"Standing Seam & ZIP Tech Roofing","description":"Waterproof roofing systems designed around drainage logic, concealed fastening, and controlled execution.","cta":"Explore Roofing Systems","href":"/systems/standing-seam-zip-tech-roofing"},{"title":"Aluminium Cladding & Covering","description":"Industrial facade systems coordinated through layout control, fixing logic, and precise execution.","cta":"Explore Cladding Systems","href":"/systems/aluminium-cladding-covering"}]},"technicalProofSnapshot":{"title":"Engineering Proof Snapshot","description":"Real technical references are shown when available. Pending states are used when a verified proof asset is not yet available.","pendingLabel":"Pending verified technical proof","items":[{"title":"Shop Drawing Coordination","description":"Layout, accessories, and sequencing reviewed before installation.","visual":{"image":{"src":"/_next/static/media/mahshahr_taxi-card.5ae0a627.webp","height":600,"width":800,"blurDataURL":"data:image/webp;base64,UklGRkwAAABXRUJQVlA4IEAAAAAwAgCdASoIAAYAAkA4JZQCdEf/gbilYR5+QAD4Y4IvQKdA39Txj8d5Tac0Q8yQBZM4SWJI2lm/+SKmJFwcEgAA","blurWidth":8,"blurHeight":6},"alt":"Shop drawing coordination reference"},"assetStatus":"available"},{"title":"Roof Waterproofing Logic","description":"Drainage, flashing, and penetration details engineered before execution.","visual":{"image":{"src":"/_next/static/media/andimeshk-card.08e7ae5d.webp","height":600,"width":800,"blurDataURL":"data:image/webp;base64,UklGRlwAAABXRUJQVlA4IFAAAADQAQCdASoIAAYAAkA4JQBOgB6K51oKAAD942M772xX/iA6BDyuiCPhL+5ZaLxXozSrNjHFzmo7gTAxvjy+xtj+H/y/E2f7gGKFdK8Bw2AAAA==","blurWidth":8,"blurHeight":6},"alt":"Roof waterproofing logic reference"},"assetStatus":"available"},{"title":"Material Optimization","description":"Procurement quantities planned to reduce waste and delays.","visual":{"image":{"src":"/_next/static/media/tabas-card.8038c6bc.webp","height":600,"width":800,"blurDataURL":"data:image/webp;base64,UklGRmAAAABXRUJQVlA4IFQAAADQAQCdASoIAAYAAkA4JZgCdAEO4c/iCAD++yafRBxTUscmew0i2KyrI/2C2elAm2BUZ83ikdPiU9+rR6JrlADCPxmNGernbFe7dMTAK8d9pWAAAAA=","blurWidth":8,"blurHeight":6},"alt":"Material optimization reference"},"assetStatus":"available"},{"title":"Inspection-Based Execution","description":"Quality checkpoints integrated during installation.","visual":{"image":{"src":"/_next/static/media/megaparsmall-atrium-card.fd98025c.webp","height":600,"width":800,"blurDataURL":"data:image/webp;base64,UklGRj4AAABXRUJQVlA4IDIAAADQAQCdASoIAAYAAkA4JZQCdAEWToLpwAD+Cw780a48x9ORxfOrIK/1t3chPsHxZq2gAA==","blurWidth":8,"blurHeight":6},"alt":"Inspection based execution reference"},"assetStatus":"available"}]},"workflowProcess":{"title":"How SIPANEL Approaches Industrial Projects","steps":[{"title":"Project Review","description":"Review project conditions, system requirements, and execution risks."},{"title":"Technical Coordination","description":"Coordinate drawings, drainage logic, details, accessories, and procurement planning."},{"title":"Execution Planning","description":"Define installation sequencing, inspection points, and quality control flow."},{"title":"Controlled Installation","description":"Execute according to technical standards, coordination logic, and engineering review."}]},"metricsStrip":{"title":"Industrial Experience Snapshot","pendingLabel":"Needs internal confirmation","metrics":[{"label":"Years of Experience","value":"pending_verified_data"},{"label":"Industrial Projects","value":"pending_verified_data"},{"label":"Executed Area","value":"pending_verified_data"},{"label":"Systems Delivered","value":"pending_verified_data"}]},"relatedResources":{"title":"Engineering Resources","pendingLabel":"Pending resource download","cta":"Download Resource","resources":[{"title":"Roof Leakage Prevention Checklist","cta":"Download Resource","href":"/resources","assetStatus":"pending"},{"title":"Sandwich Panel Selection Guide","cta":"Download Resource","href":"/resources","assetStatus":"pending"},{"title":"Shop Drawing Review Guide","cta":"Download Resource","href":"/resources","assetStatus":"pending"}]}},"fa":{"seo":{"title":"درباره SIPANEL | مهندسی پوسته صنعتی و اجرای کنترل‌شده","metaDescription":"ببینید SIPANEL چگونه با بازبینی مهندسی، تامین هوشمند، منطق آب‌بندی و نصب کنترل‌شده، ریسک اجرای پروژه‌های صنعتی را کاهش می‌دهد.","h1":"سیستم‌های پوسته صنعتی با کنترل مهندسی."},"hero":{"eyebrow":"درباره SIPANEL","h1":"سیستم‌های پوسته صنعتی با کنترل مهندسی.","subheadline":"SIPANEL با بازبینی مهندسی، تامین هوشمند و نصب کنترل‌شده به پروژه‌های صنعتی کمک می‌کند تا ریسک نشتی، پرت مصالح، خطاهای هماهنگی و عدم‌قطعیت اجرا را کاهش دهند.","primaryCta":"درخواست مشاوره فنی","secondaryCta":"مشاهده سیستم‌ها","trustMicrocopy":"بر پایه کنترل اجرای صنعتی، نه فقط تامین مصالح.","visualAlt":"کلاژ پروژه صنعتی SIPANEL"},"conversionCta":{"headline":"ریسک اجرا را پیش از شروع ساخت کاهش دهید.","text":"برای پروژه پنل صنعتی، سقف یا کلادینگ خود مشاوره فنی درخواست کنید.","primaryCta":"درخواست مشاوره فنی","secondaryCta":"تماس از طریق واتساپ","contactHint":"فقط اطلاعات تماس تاییدشده."},"stickyMobileCta":{"label":"مشاوره فنی","secondaryAction":"واتساپ"},"companyPositioning":{"title":"فراتر از تامین مصالح.","cards":[{"title":"بازبینی مهندسی","description":"SIPANEL منطق سیستم، زهکشی، چیدمان، آب‌بندی و شرایط نصب را پیش از تامین و اجرا بررسی می‌کند."},{"title":"تامین هوشمند","description":"مقادیر، متعلقات، فلاشینگ‌ها، تریم‌ها و مصالح به‌گونه‌ای هماهنگ می‌شوند که پرت و تاخیر کاهش یابد."},{"title":"نصب کنترل‌شده","description":"اجرا بر اساس جزئیات فنی، منطق توالی، نقاط بازرسی و هماهنگی مهندسی انجام می‌شود."}]},"companyStory":{"title":"چرا SIPANEL شکل گرفت","lead":"مشکلات پوسته صنعتی معمولاً پیش از نصب شروع می‌شوند: نقشه‌های نامشخص، انتخاب ضعیف سیستم، توالی‌گذاری نامناسب و هماهنگی‌نشده.","points":[{"title":"مسئله بازار","description":"اغلب پروژه‌ها با مصالح شروع می‌شوند، نه با بازبینی سیستم. نتیجه آن ریسک نشتی، پرت و انحراف در اجراست."},{"title":"چرا اجرا شکست می‌خورد","description":"وقتی نقشه‌ها، منطق زهکشی، متعلقات و توالی سایت هم‌راستا نباشند، تیم اجرا زمان را صرف اصلاح خطاهای قابل پیشگیری می‌کند."},{"title":"چرا مهندسی مهم است","description":"بازبینی مهندسی پیش از تامین و نصب، عدم‌قطعیت را در زمانی کاهش می‌دهد که اصلاح هنوز هزینه کمی دارد."},{"title":"رویکرد SIPANEL","description":"SIPANEL از بازبینی سیستم تا نصب کنترل‌شده پیش می‌رود تا پروژه هماهنگ، قابل‌سنجش و فنی باقی بماند."}],"visual":{"image":"$3","alt":"نمای مرجع پروژه صنعتی"}},"corePrinciples":{"title":"اصول اصلی اجرا","principles":[{"title":"مهندسی پیش از نصب","description":"ریسک پروژه باید پیش از شروع اجرای سایت بررسی شود."},{"title":"منطق آب‌بندی مهم است","description":"زهکشی، فلاشینگ‌ها، همپوشانی‌ها، درزها و نفوذها عملکرد بلندمدت سقف را تعیین می‌کنند."},{"title":"چیدمان کیفیت را کنترل می‌کند","description":"ریتم پنل، هم‌راستایی نما و برنامه‌ریزی مقدار، کیفیت اجرا و پرت را تحت تاثیر قرار می‌دهند."},{"title":"اجرا به هماهنگی نیاز دارد","description":"کیفیت نصب به توالی، نقشه‌ها، تامین و نقاط بازرسی وابسته است."},{"title":"شواهد فنی مهم‌تر از ادعاست","description":"جزئیات واقعی، دیاگرام‌ها و شواهد اجرا از زبان بازاریابی مهم‌ترند."},{"title":"پروژه‌های صنعتی کنترل می‌خواهند","description":"سیستم‌های صنعتی بزرگ به برنامه‌ریزی، تایید و انضباط مهندسی نیاز دارند."}]},"systemsOverview":{"title":"سیستم‌های پوسته صنعتی","systems":[{"title":"سیستم‌های پنل ساندویچی","description":"چیدمان پنل، عایق، متعلقات، هماهنگی فلاشینگ و کنترل نصب.","cta":"مشاهده سیستم‌های پنل","href":"/systems/sandwich-panel-systems"},{"title":"سقف Standing Seam و ZIP Tech","description":"سیستم‌های سقف آب‌بند بر پایه منطق زهکشی، اتصال پنهان و اجرای کنترل‌شده.","cta":"مشاهده سیستم‌های سقف","href":"/systems/standing-seam-zip-tech-roofing"},{"title":"کلادینگ و پوشش آلومینیومی","description":"سیستم‌های نمای صنعتی با کنترل چیدمان، منطق فیکسینگ و اجرای دقیق.","cta":"مشاهده سیستم‌های کلادینگ","href":"/systems/aluminium-cladding-covering"}]},"technicalProofSnapshot":{"title":"نمونه شواهد مهندسی","description":"اگر شواهد فنی تاییدشده موجود باشد نمایش داده می‌شود. در غیر این صورت از حالت در انتظار استفاده می‌شود.","pendingLabel":"شواهد فنی تاییدشده در انتظار است","items":[{"title":"هماهنگی شاپ‌دراوینگ","description":"چیدمان، متعلقات و توالی پیش از نصب بررسی می‌شوند.","visual":{"image":"$4","alt":"مرجع هماهنگی شاپ‌دراوینگ"},"assetStatus":"available"},{"title":"منطق آب‌بندی سقف","description":"زهکشی، فلاشینگ و نفوذها پیش از اجرا مهندسی می‌شوند.","visual":{"image":"$5","alt":"مرجع منطق آب‌بندی سقف"},"assetStatus":"available"},{"title":"بهینه‌سازی متریال","description":"مقادیر تامین برای کاهش پرت و تاخیر برنامه‌ریزی می‌شوند.","visual":{"image":"$6","alt":"مرجع بهینه‌سازی متریال"},"assetStatus":"available"},{"title":"اجرای مبتنی بر بازرسی","description":"نقاط کنترل کیفیت در طول نصب ادغام می‌شوند.","visual":{"image":"$7","alt":"مرجع اجرای مبتنی بر بازرسی"},"assetStatus":"available"}]},"workflowProcess":{"title":"SIPANEL چگونه پروژه‌های صنعتی را پیش می‌برد","steps":[{"title":"بازبینی پروژه","description":"شرایط پروژه، نیازهای سیستم و ریسک‌های اجرا بررسی می‌شوند."},{"title":"هماهنگی فنی","description":"نقشه‌ها، منطق زهکشی، جزئیات، متعلقات و برنامه‌ریزی تامین هماهنگ می‌شوند."},{"title":"برنامه‌ریزی اجرا","description":"توالی نصب، نقاط بازرسی و جریان کنترل کیفیت تعریف می‌شود."},{"title":"نصب کنترل‌شده","description":"اجرا مطابق استانداردهای فنی، منطق هماهنگی و بازبینی مهندسی انجام می‌شود."}]},"metricsStrip":{"title":"نمایه تجربه صنعتی","pendingLabel":"نیازمند تایید داخلی","metrics":[{"label":"سال‌های تجربه","value":"pending_verified_data"},{"label":"پروژه‌های صنعتی","value":"pending_verified_data"},{"label":"متراژ اجرا شده","value":"pending_verified_data"},{"label":"سیستم‌های تحویل‌شده","value":"pending_verified_data"}]},"relatedResources":{"title":"منابع مهندسی","pendingLabel":"دانلود منبع در انتظار است","cta":"دانلود منبع","resources":[{"title":"چک‌لیست پیشگیری از نشتی سقف","cta":"دانلود منبع","href":"/resources","assetStatus":"pending"},{"title":"راهنمای انتخاب پنل ساندویچی","cta":"دانلود منبع","href":"/resources","assetStatus":"pending"},{"title":"راهنمای بازبینی شاپ‌دراوینگ","cta":"دانلود منبع","href":"/resources","assetStatus":"pending"}]}},"ar":{"seo":{"title":"حول SIPANEL | هندسة الغلاف الصناعي والتنفيذ الخاضع للتحكم","metaDescription":"تعرف على كيفية مساعدة SIPANEL للمشاريع الصناعية في تقليل مخاطر التنفيذ عبر المراجعة الهندسية، والمشتريات الذكية، ومنطق العزل المائي، والتركيب المنضبط.","h1":"أنظمة الغلاف الصناعي الخاضعة للتحكم الهندسي."},"hero":{"eyebrow":"حول SIPANEL","h1":"أنظمة الغلاف الصناعي الخاضعة للتحكم الهندسي.","subheadline":"تساعد SIPANEL المشاريع الصناعية على تقليل خطر التسرب، وهدر المواد، وأخطاء التنسيق، وعدم اليقين في التنفيذ عبر المراجعة الهندسية، والمشتريات الذكية، والتركيب المنضبط.","primaryCta":"طلب استشارة فنية","secondaryCta":"عرض الأنظمة","trustMicrocopy":"مبنية على ضبط التنفيذ الصناعي، وليس مجرد توريد المواد.","visualAlt":"كولاج مشروع صناعي من SIPANEL"},"conversionCta":{"headline":"قلل مخاطر التنفيذ قبل بدء البناء.","text":"اطلب استشارة فنية لمشروع الألواح أو الأسقف أو الكسوة الصناعية.","primaryCta":"طلب استشارة فنية","secondaryCta":"التواصل عبر واتساب","contactHint":"بيانات التواصل الموثقة فقط."},"stickyMobileCta":{"label":"استشارة فنية","secondaryAction":"واتساب"},"companyPositioning":{"title":"أكثر من مجرد توريد مواد.","cards":[{"title":"المراجعة الهندسية","description":"تراجع SIPANEL منطق النظام، والتصريف، والتوزيع، والعزل المائي، وظروف التركيب قبل الشراء والتنفيذ."},{"title":"مشتريات ذكية","description":"تُنسق الكميات والملحقات والفلاشينغ والأطراف والمواد لتقليل الهدر وتجنب تأخير الموقع."},{"title":"تركيب منضبط","description":"ينفذ العمل وفق التفاصيل الفنية ومنطق التسلسل ونقاط الفحص والتنسيق الهندسي."}]},"companyStory":{"title":"لماذا وُجدت SIPANEL","lead":"غالبًا ما تبدأ مشكلات الغلاف الصناعي قبل التركيب بفترة طويلة: رسومات غير واضحة، اختيار نظام ضعيف، وتسلسل غير منظم، وتنسيق غير مخطط.","points":[{"title":"مشكلة السوق","description":"تبدأ المشاريع غالبًا بالمواد وليس بمراجعة النظام، وهذا يخلق خطر التسرب والهدر والانحراف في التنفيذ."},{"title":"لماذا يفشل التنفيذ","description":"عندما لا تكون الرسومات ومنطق التصريف والملحقات وتسلسل الموقع متناسقة، يقضي فريق التنفيذ الوقت في معالجة مشكلات كان يمكن تجنبها."},{"title":"لماذا تهم الهندسة","description":"تقلل المراجعة الهندسية عدم اليقين قبل الشراء والتركيب، عندما لا تزال التعديلات منخفضة التكلفة."},{"title":"كيف تتعامل SIPANEL مع المشاريع","description":"تعمل SIPANEL من مراجعة النظام حتى التركيب المنضبط بحيث يبقى المشروع منسقًا وقابلًا للقياس ومدافعًا عنه فنيًا."}],"visual":{"image":"$3","alt":"مرجع بصري لهندسة مشروع صناعي"}},"corePrinciples":{"title":"مبادئ التنفيذ الأساسية","principles":[{"title":"الهندسة قبل التركيب","description":"يجب مراجعة مخاطر المشروع قبل بدء التنفيذ في الموقع."},{"title":"منطق العزل المائي مهم","description":"التصريف والفلاشينغ والتراكبات والدرزات والاختراقات تحدد أداء السقف على المدى الطويل."},{"title":"التوزيع يتحكم في الجودة","description":"إيقاع الألواح، ومحاذاة الواجهات، وتخطيط الكميات تؤثر في جودة التنفيذ والهدر."},{"title":"التنفيذ يحتاج تنسيقًا","description":"تعتمد جودة التركيب على التسلسل والرسومات والمشتريات ونقاط الفحص."},{"title":"الدليل الفني أهم من الادعاء","description":"التفاصيل الحقيقية والرسومات وشواهد التنفيذ أهم من لغة التسويق."},{"title":"المشاريع الصناعية تحتاج ضبطًا","description":"تحتاج الأنظمة الصناعية الكبيرة إلى التخطيط والتحقق والانضباط الهندسي."}]},"systemsOverview":{"title":"أنظمة الغلاف الصناعي","systems":[{"title":"أنظمة ألواح الساندويش","description":"توزيع الألواح، والعزل، والملحقات، وتنسيق الفلاشينغ، وضبط التركيب.","cta":"استكشاف أنظمة الألواح","href":"/systems/sandwich-panel-systems"},{"title":"Standing Seam وZIP Tech للأسقف","description":"أنظمة أسقف مقاومة للماء مبنية على منطق التصريف، والتثبيت المخفي، والتنفيذ المنضبط.","cta":"استكشاف أنظمة الأسقف","href":"/systems/standing-seam-zip-tech-roofing"},{"title":"كسوة وتغطية الألمنيوم","description":"أنظمة واجهات صناعية بتنسيق التوزيع ومنطق التثبيت والتنفيذ الدقيق.","cta":"استكشاف أنظمة الكسوة","href":"/systems/aluminium-cladding-covering"}]},"technicalProofSnapshot":{"title":"ملخص الأدلة الهندسية","description":"تُعرض المراجع الفنية الحقيقية عندما تكون متاحة. ويُستخدم وضع الانتظار عندما لا تتوفر مادة موثقة.","pendingLabel":"أدلة فنية موثقة قيد الانتظار","items":[{"title":"تنسيق الرسومات التنفيذية","description":"تراجع التوزيع والملحقات والتسلسل قبل التركيب.","visual":{"image":"$4","alt":"مرجع تنسيق الرسومات التنفيذية"},"assetStatus":"available"},{"title":"منطق عزل السقف","description":"تُهندس التصريف والفلاشينغ والاختراقات قبل التنفيذ.","visual":{"image":"$5","alt":"مرجع منطق عزل السقف"},"assetStatus":"available"},{"title":"تحسين المواد","description":"تُخطط كميات الشراء لتقليل الهدر والتأخير.","visual":{"image":"$6","alt":"مرجع تحسين المواد"},"assetStatus":"available"},{"title":"تنفيذ قائم على الفحص","description":"تُدمج نقاط فحص الجودة أثناء التركيب.","visual":{"image":"$7","alt":"مرجع التنفيذ القائم على الفحص"},"assetStatus":"available"}]},"workflowProcess":{"title":"كيف تتعامل SIPANEL مع المشاريع الصناعية","steps":[{"title":"مراجعة المشروع","description":"تُراجع ظروف المشروع ومتطلبات النظام ومخاطر التنفيذ."},{"title":"التنسيق الفني","description":"تُنسق الرسومات ومنطق التصريف والتفاصيل والملحقات وتخطيط المشتريات."},{"title":"تخطيط التنفيذ","description":"يُحدد تسلسل التركيب ونقاط الفحص ومسار ضبط الجودة."},{"title":"تركيب منضبط","description":"يُنفذ العمل وفق المعايير الفنية ومنطق التنسيق والمراجعة الهندسية."}]},"metricsStrip":{"title":"ملخص الخبرة الصناعية","pendingLabel":"بحاجة إلى تأكيد داخلي","metrics":[{"label":"سنوات الخبرة","value":"pending_verified_data"},{"label":"المشاريع الصناعية","value":"pending_verified_data"},{"label":"المساحة المنفذة","value":"pending_verified_data"},{"label":"الأنظمة المسلمة","value":"pending_verified_data"}]},"relatedResources":{"title":"الموارد الهندسية","pendingLabel":"تنزيل المورد قيد الانتظار","cta":"تنزيل المورد","resources":[{"title":"قائمة منع تسرب السقف","cta":"تنزيل المورد","href":"/resources","assetStatus":"pending"},{"title":"دليل اختيار ألواح الساندويش","cta":"تنزيل المورد","href":"/resources","assetStatus":"pending"},{"title":"دليل مراجعة الرسومات التنفيذية","cta":"تنزيل المورد","href":"/resources","assetStatus":"pending"}]}},"ru":{"seo":{"title":"О SIPANEL | Инженерия промышленной оболочки и контролируемое выполнение","metaDescription":"Узнайте, как SIPANEL снижает риски промышленных проектов через инженерную проверку, умные закупки, логику гидроизоляции и контролируемый монтаж.","h1":"Промышленные системы оболочки под инженерным контролем."},"hero":{"eyebrow":"О SIPANEL","h1":"Промышленные системы оболочки под инженерным контролем.","subheadline":"SIPANEL помогает промышленным проектам снижать риск протечек, перерасхода материалов, ошибок координации и неопределённости исполнения через инженерную проверку, умные закупки и контролируемый монтаж.","primaryCta":"Запросить техническую консультацию","secondaryCta":"Посмотреть системы","trustMicrocopy":"Основано на контроле промышленного исполнения, а не только на поставке материалов.","visualAlt":"Коллаж промышленного проекта SIPANEL"},"conversionCta":{"headline":"Снизьте риск выполнения до начала строительства.","text":"Запросите техническую консультацию для вашего проекта панелей, кровли или облицовки.","primaryCta":"Запросить техническую консультацию","secondaryCta":"Связаться через WhatsApp","contactHint":"Только проверенные контактные данные."},"stickyMobileCta":{"label":"Техническая консультация","secondaryAction":"WhatsApp"},"companyPositioning":{"title":"Больше, чем поставка материалов.","cards":[{"title":"Инженерная проверка","description":"SIPANEL проверяет логику системы, водоотвод, раскладку, гидроизоляцию и условия монтажа до закупки и выполнения."},{"title":"Умные закупки","description":"Объёмы, комплектующие, примыкания, доборные элементы и материалы координируются для снижения отходов и задержек."},{"title":"Контролируемый монтаж","description":"Выполнение следует техническим деталям, логике последовательности, контрольным точкам и инженерной координации."}]},"companyStory":{"title":"Почему существует SIPANEL","lead":"Проблемы промышленной оболочки обычно начинаются задолго до монтажа: неясные чертежи, слабый выбор системы, плохая последовательность и несогласованность работ.","points":[{"title":"Проблема рынка","description":"Проекты часто начинают с материалов, а не с проверки системы. Это создаёт риск протечек, потерь и отклонений в выполнении."},{"title":"Почему выполнение срывается","description":"Когда чертежи, логика водоотвода, комплектующие и последовательность работ не согласованы, команда тратит время на исправление предотвратимых проблем."},{"title":"Почему важна инженерия","description":"Инженерная проверка снижает неопределённость до закупки и монтажа, когда изменения ещё недороги."},{"title":"Как SIPANEL ведёт проекты","description":"SIPANEL работает от проверки системы до контролируемого монтажа, чтобы проект оставался согласованным, измеримым и технически обоснованным."}],"visual":{"image":"$3","alt":"Инженерный референс промышленного проекта"}},"corePrinciples":{"title":"Основные принципы выполнения","principles":[{"title":"Сначала инженерия, потом монтаж","description":"Риск проекта нужно проверять до начала работ на площадке."},{"title":"Логика гидроизоляции имеет значение","description":"Водоотвод, примыкания, нахлёсты, швы и проходки определяют долговечность кровли."},{"title":"Раскладка управляет качеством","description":"Ритм панелей, выравнивание фасада и планирование объёмов влияют на качество и отходы."},{"title":"Выполнение требует координации","description":"Качество монтажа зависит от последовательности, чертежей, закупок и точек контроля."},{"title":"Техническое доказательство важнее заявлений","description":"Реальные узлы, схемы и доказательства выполнения важнее маркетинговых формулировок."},{"title":"Промышленные проекты требуют контроля","description":"Крупные промышленные системы требуют планирования, проверки и инженерной дисциплины."}]},"systemsOverview":{"title":"Системы промышленной оболочки","systems":[{"title":"Системы сэндвич-панелей","description":"Раскладка панелей, утепление, комплектующие, согласование примыканий и контроль монтажа.","cta":"Смотреть системы панелей","href":"/systems/sandwich-panel-systems"},{"title":"Кровля Standing Seam и ZIP Tech","description":"Гидроизоляционные кровли, спроектированные вокруг логики водоотвода, скрытого крепежа и контролируемого выполнения.","cta":"Смотреть системы кровли","href":"/systems/standing-seam-zip-tech-roofing"},{"title":"Алюминиевая облицовка и покрытие","description":"Промышленные фасадные системы с контролем раскладки, логики крепления и точного выполнения.","cta":"Смотреть системы облицовки","href":"/systems/aluminium-cladding-covering"}]},"technicalProofSnapshot":{"title":"Сводка инженерных доказательств","description":"Показываются реальные технические материалы, если они доступны. Если подтверждённый материал отсутствует, используется состояние ожидания.","pendingLabel":"Подтверждённое техническое доказательство ожидается","items":[{"title":"Согласование рабочих чертежей","description":"Раскладка, комплектующие и последовательность проверяются до монтажа.","visual":{"image":"$4","alt":"Референс согласования рабочих чертежей"},"assetStatus":"available"},{"title":"Логика гидроизоляции кровли","description":"Водоотвод, примыкания и проходки проектируются до выполнения.","visual":{"image":"$5","alt":"Референс логики гидроизоляции кровли"},"assetStatus":"available"},{"title":"Оптимизация материалов","description":"Объёмы закупок планируются для снижения отходов и задержек.","visual":{"image":"$6","alt":"Референс оптимизации материалов"},"assetStatus":"available"},{"title":"Выполнение через контроль","description":"Точки контроля качества встроены в процесс монтажа.","visual":{"image":"$7","alt":"Референс выполнения через контроль"},"assetStatus":"available"}]},"workflowProcess":{"title":"Как SIPANEL подходит к промышленным проектам","steps":[{"title":"Проверка проекта","description":"Проверяются условия проекта, требования системы и риски выполнения."},{"title":"Техническая координация","description":"Согласуются чертежи, логика водоотвода, детали, комплектующие и закупки."},{"title":"Планирование выполнения","description":"Определяются последовательность монтажа, точки контроля и поток качества."},{"title":"Контролируемый монтаж","description":"Выполнение идёт по техническим стандартам, логике координации и инженерной проверке."}]},"metricsStrip":{"title":"Сводка промышленного опыта","pendingLabel":"Требует внутреннего подтверждения","metrics":[{"label":"Лет опыта","value":"pending_verified_data"},{"label":"Промышленных проектов","value":"pending_verified_data"},{"label":"Выполненная площадь","value":"pending_verified_data"},{"label":"Систем сдано","value":"pending_verified_data"}]},"relatedResources":{"title":"Инженерные ресурсы","pendingLabel":"Загрузка ресурса ожидается","cta":"Скачать ресурс","resources":[{"title":"Чек-лист предотвращения протечек кровли","cta":"Скачать ресурс","href":"/resources","assetStatus":"pending"},{"title":"Ру