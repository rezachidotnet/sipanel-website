d:["$","$Le",null,{"locale":"fa","now":"$D2026-05-23T17:32:16.330Z","timeZone":"Asia/Tehran","messages":{"metadata":{"title":"SIPANEL | مهندسی پوسته ساختمان صنعتی","description":"سیستم‌های پوسته صنعتی با رویکرد مهندسی، طراحی کنترل‌شده، تامین و اجرای دقیق."},"nav":{"home":"خانه","systems":"سیستم‌ها","projects":"پروژه‌ها","process":"فرایند","about":"درباره ما","resources":"منابع","contact":"تماس"},"header":{"selectLanguage":"انتخاب زبان","menu":"منو","phone":"+98 31 3675 1101","email":"info@sipanelco.ir","cta":"دریافت بررسی مهندسی رایگان"},"footer":{"navigationLabel":"ناوبری پابرگ","systems":"سیستم‌ها","projects":"پروژه‌ها","resources":"منابع","company":"شرکت","contact":"تماس"},"proofSnapshot":{"eyebrow":"اثبات مهندسی","title":"کنترل فنی پیش از اجرا","pendingAsset":"در انتظار دارایی فنی واقعی","viewerPending":"نمایشگر تمام‌صفحه برای دارایی فنی آینده آماده است","cards":{"shopDrawing":{"title":"دقت شاپ‌دراوینگ","proof":"چیدمان پانل، منطق اتصال و توالی نصب پیش از اجرا بررسی می‌شود.","visualLabel":"چیدمان پانل"},"waterproofing":{"title":"منطق آب‌بندی","proof":"زهکشی، فلاشینگ، هم‌پوشانی و جزئیات سقف برای کاهش ریسک نفوذ آب مهندسی می‌شود.","visualLabel":"مسیر زهکشی"},"materialOptimization":{"title":"بهینه‌سازی متریال","proof":"تامین پروژه بر اساس مقادیر دقیق، کاهش پرت و کنترل هزینه برنامه‌ریزی می‌شود.","visualLabel":"کنترل BOM"}}},"stickyCta":{"label":"اقدام موبایل پروژه","primary":"دریافت بررسی مهندسی","whatsapp":"واتساپ"},"process":{"title":"مهندسی ← تامین ← اجرا","steps":{"engineeringReview":{"title":"بررسی مهندسی","description":"نقشه‌های پروژه، محدودیت‌های سایت، الزامات سیستم و ریسک‌های نفوذ آب پیش از تامین بررسی می‌شود."},"smartProcurement":{"title":"تامین هوشمند","description":"مقادیر پانل، اکسسوری‌ها، فلاشینگ‌ها و مصالح پروژه برای کاهش پرت و تاخیر برنامه‌ریزی می‌شود."},"controlledInstallation":{"title":"نصب کنترل‌شده","description":"اجرا بر اساس توالی هماهنگ، جزئیات فنی و کنترل کیفیت بازرسی‌محور پیش می‌رود."},"finalVerification":{"title":"بازبینی نهایی","description":"سیستم تحویل‌شده بر اساس کیفیت اجرا، جزئیات آب‌بندی و الزامات پروژه کنترل می‌شود."}}},"caseStudies":{"eyebrow":"اثبات پروژه","title":"کیس‌استادی‌ها با زمینه مهندسی قابل سنجش","cta":"مشاهده پروژه‌های اجراشده","challenge":"چالش","engineeringDecision":"تصمیم مهندسی","measuredResult":"نتیجه ثبت‌شده"},"comparison":{"title":"تامین صرف در برابر اجرای کنترل‌شده مهندسی","columns":{"supplyOnly":"رویکرد معمول تامین صرف","sipanel":"رویکرد کنترل‌شده مهندسی SIPANEL"},"points":{"panelSelection":{"label":"انتخاب پانل","typical":"نوع پانل ممکن است بیشتر بر اساس موجودی یا قیمت انتخاب شود و محدودیت‌های سایت کمتر بررسی شود.","sipanel":"انتخاب پانل با کاربری ساختمان، هندسه سقف، نیاز عایق‌کاری و ریسک اجرا کنترل می‌شود."},"waterproofingResponsibility":{"label":"مسئولیت آب‌بندی","typical":"جزئیات آب‌بندی ممکن است هنگام نصب به برداشت اجرایی سایت وابسته شود.","sipanel":"زهکشی، فلاشینگ، هم‌پوشانی و منطق درزبندی پیش از اجرا هماهنگ می‌شود تا ریسک نفوذ آب کاهش یابد."},"materialWaste":{"label":"پرت متریال","typical":"ممکن است سفارش متریال پیش از نهایی شدن چیدمان پانل و اکسسوری‌ها انجام شود.","sipanel":"تامین بر پایه چیدمان هماهنگ و برنامه‌ریزی متریال انجام می‌شود تا کنترل پرت بهتر شود."},"installationCoordination":{"label":"هماهنگی نصب","typical":"توالی نصب و مسائل تراز ممکن است در محل پروژه حل‌وفصل شود.","sipanel":"نصب بر اساس توالی برنامه‌ریزی‌شده، نقاط کنترل تراز و جزئیات فنی هماهنگ پیش می‌رود."},"riskBeforeConstruction":{"label":"ریسک پیش از ساخت","typical":"ریسک‌های پروژه معمولاً پس از رسیدن مصالح یا شروع نصب آشکار می‌شوند.","sipanel":"ریسک‌های کلیدی پیش از تامین بررسی می‌شوند تا تصمیم‌ها زودتر کنترل شوند."},"technicalDocumentation":{"label":"مستندات فنی","typical":"مستندات ممکن است به اطلاعات محصول و راهنمای نصب پایه محدود شود.","sipanel":"شاپ‌دراوینگ، جزئیات و منطق تامین، مسئولیت‌پذیری اجرا را شفاف‌تر می‌کند."}}},"resourcesPreview":{"title":"منابع فنی برای تصمیم‌گیری بهتر پروژه","cta":"دانلود منبع مهندسی","pending":"فایل منبع در انتظار آماده‌سازی است","types":{"guide":"راهنما","checklist":"چک‌لیست"},"cards":{"panelSelection":{"title":"راهنمای انتخاب پانل","description":"نوع پانل، انتخاب هسته، ضخامت، منطق اتصال، نیاز عایق‌کاری و شرایط پروژه پیش از تامین بررسی می‌شود."},"roofLeakage":{"title":"چک‌لیست پیشگیری از نشت سقف","description":"شیب، زهکشی، فلاشینگ‌ها، نفوذی‌ها، ناودان‌ها و ریسک نصب پیش از شروع سقف کنترل می‌شود."},"shopDrawing":{"title":"راهنمای بازبینی شاپ‌دراوینگ","description":"چیدمان پانل، اکسسوری‌ها، منطق فلاشینگ، مقادیر و هماهنگی اجرا پیش از نصب بررسی می‌شود."}}},"rfq":{"eyebrow":"درخواست بررسی مهندسی","title":"پروژه خود را با اطمینان شروع کنید.","intro":"جزئیات پروژه را ارسال کنید تا SIPANEL محدوده پوسته، انتخاب سیستم، ریسک تامین و الزامات اجرا را بررسی کند.","backendPending":"اتصال بک‌اند در انتظار پیاده‌سازی است","stepsLabel":"مراحل فرم RFQ","steps":{"0":"اطلاعات تماس","1":"محدوده پروژه","2":"جزئیات فنی"},"fields":{"name":"نام و نام خانوادگی","company":"شرکت","phone":"تلفن","whatsapp":"واتساپ","email":"ایمیل","project_type":"نوع پروژه","project_location":"موقعیت پروژه","estimated_area":"مساحت تقریبی","message":"جزئیات پروژه","optional_file_upload":"آپلود نقشه یا فایل پروژه"},"projectTypes":{"sandwichPanel":"سیستم‌های ساندویچ پانل","standingSeam":"سقف Standing Seam و ZIP Tech","aluminiumCladding":"پوشش و کلادینگ آلومینیومی","fullEnvelope":"پوسته کامل صنعتی","technicalReview":"بررسی فنی / مشاوره","other":"سایر"},"placeholders":{"select":"نوع پروژه را انتخاب کنید"},"validation":{"required":"تکمیل این فیلد ضروری است.","email":"ایمیل معتبر وارد کنید.","message":"یک توضیح فنی کوتاه درباره پروژه وارد کنید.","fileSize":"حداکثر حجم فایل ۱۰ مگابایت است.","fileType":"فرمت‌های مجاز: PDF، JPG، PNG، DWG.","spam":"بررسی ضداسپم ناموفق بود."},"contact":{"title":"اطلاعات تماس SIPANEL","note":"اطلاعات تماس فقط از داده‌های تولیدی تاییدشده نمایش داده می‌شود."},"fileHelp":"اختیاری. PDF، JPG، PNG یا DWG تا ۱۰ مگابایت.","spamPlaceholder":"محافظت ضداسپم فعال است.","privacy":"جزئیات پروژه فقط برای بررسی مهندسی و پیگیری استفاده می‌شود.","back":"قبلی","next":"بعدی","submit":"درخواست مشاوره فنی","submitting":"در حال ارسال درخواست...","success":"جزئیات پروژه از اعتبارسنجی فرانت‌اند عبور کرد.","error":"اندپوینت بک‌اند هنوز متصل نیست. ساختار فرانت‌اند RFQ برای اتصال آماده است."},"hero":{"eyebrow":"قدرت مهندسی. اجرای کنترل‌شده.","headline":"ریسک پروژه را پیش از شروع ساخت کاهش دهید.","subheadline":"شاپ‌دراوینگ دقیق، تامین کنترل‌شده و سیستم‌های نصب مهندسی‌شده برای ساختمان‌های صنعتی.","primaryCta":"دریافت بررسی مهندسی رایگان","secondaryCta":"درخواست بررسی هزینه پروژه","visualAlt":"پروژه پوسته صنعتی SIPANEL با سیستم‌های مهندسی‌شده سقف و نما","proofValue":"مهندسی","proofLabel":"کنترل کیفیت محور"}},"children":[["$","$Lf",null,{"locale":"fa","dir":"rtl"}],"$L10",["$","main",null,{"children":["$","$L8",null,{"parallelRouterKey":"children","segmentPath":["children","$9","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$La",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}],"$L11"]}]
