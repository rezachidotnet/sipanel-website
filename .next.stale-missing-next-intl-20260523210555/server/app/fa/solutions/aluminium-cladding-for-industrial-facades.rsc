:"سیستم تحویل‌شده بر اساس کیفیت اجرا، جزئیات آب‌بندی و الزامات پروژه کنترل می‌شود."}}},"caseStudies":{"eyebrow":"اثبات پروژه","title":"کیس‌استادی‌ها با زمینه مهندسی قابل سنجش","cta":"مشاهده پروژه‌های اجراشده","challenge":"چالش","engineeringDecision":"تصمیم مهندسی","measuredResult":"نتیجه ثبت‌شده"},"comparison":{"title":"تامین صرف در برابر اجرای کنترل‌شده مهندسی","columns":{"supplyOnly":"رویکرد معمول تامین صرف","sipanel":"رویکرد کنترل‌شده مهندسی SIPANEL"},"points":{"panelSelection":{"label":"انتخاب پانل","typical":"نوع پانل ممکن است بیشتر بر اساس موجودی یا قیمت انتخاب شود و محدودیت‌های سایت کمتر بررسی شود.","sipanel":"انتخاب پانل با کاربری ساختمان، هندسه سقف، نیاز عایق‌کاری و ریسک اجرا کنترل می‌شود."},"waterproofingResponsibility":{"label":"مسئولیت آب‌بندی","typical":"جزئیات آب‌بندی ممکن است هنگام نصب به برداشت اجرایی سایت وابسته شود.","sipanel":"زهکشی، فلاشینگ، هم‌پوشانی و منطق درزبندی پیش از اجرا هماهنگ می‌شود تا ریسک نفوذ آب کاهش یابد."},"materialWaste":{"label":"پرت متریال","typical":"ممکن است سفارش متریال پیش از نهایی شدن چیدمان پانل و اکسسوری‌ها انجام شود.","sipanel":"تامین بر پایه چیدمان هماهنگ و برنامه‌ریزی متریال انجام می‌شود تا کنترل پرت بهتر شود."},"installationCoordination":{"label":"هماهنگی نصب","typical":"توالی نصب و مسائل تراز ممکن است در محل پروژه حل‌وفصل شود.","sipanel":"نصب بر اساس توالی برنامه‌ریزی‌شده، نقاط کنترل تراز و جزئیات فنی هماهنگ پیش می‌رود."},"riskBeforeConstruction":{"label":"ریسک پیش از ساخت","typical":"ریسک‌های پروژه معمولاً پس از رسیدن مصالح یا شروع نصب آشکار می‌شوند.","sipanel":"ریسک‌های کلیدی پیش از تامین بررسی می‌شوند تا تصمیم‌ها زودتر کنترل شوند."},"technicalDocumentation":{"label":"مستندات فنی","typical":"مستندات ممکن است به اطلاعات محصول و راهنمای نصب پایه محدود شود.","sipanel":"شاپ‌دراوینگ، جزئیات و منطق تامین، مسئولیت‌پذیری اجرا را شفاف‌تر می‌کند."}}},"resourcesPreview":{"title":"منابع فنی برای تصمیم‌گیری بهتر پروژه","cta":"دانلود منبع مهندسی","pending":"فایل منبع در انتظار آماده‌سازی است","types":{"guide":"راهنما","checklist"