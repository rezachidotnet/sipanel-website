":"سیستم تحویل‌شده بر اساس کیفیت اجرا، جزئیات آب‌بندی و الزامات پروژه کنترل می‌شود."}}},"caseStudies":{"eyebrow":"اثبات پروژه","title":"کیس‌استادی‌ها با زمینه مهندسی قابل سنجش","cta":"مشاهده پروژه‌های اجراشده","challenge":"چالش","engineeringDecision":"تصمیم مهندسی","measuredResult":"نتیجه ثبت‌شده"},"comparison":{"title":"تامین صرف در برابر اجرای کنترل‌شده مهندسی","columns":{"supplyOnly":"رویکرد معمول تامین صرف","sipanel":"رویکرد کنترل‌شده مهندسی SIPANEL"},"points":{"panelSelection":{"label":"انتخاب پانل","typical":"نوع پانل ممکن است بیشتر بر اساس موجودی یا قیمت انتخاب شود و محدودیت‌های سایت کمتر بررسی شود.","sipanel":"انتخاب پانل با کاربری ساختمان، هندسه سقف، نیاز عایق‌کاری و ریسک اجرا کنترل می‌شود."},"waterproofingResponsibility":{"label":"مسئولیت آب‌بندی","typical":"جزئیات آب‌بندی ممکن است هنگام نصب به برداشت اجرایی سایت وابسته شود.","sipanel":"زهکشی، فلاشینگ، هم‌پوشانی و منطق درزبندی پیش از اجرا هماهنگ می‌شود تا ریسک نفوذ آب کاهش یابد."},"materialWaste":{"label":"پرت متریال","typical":"ممکن است سفارش متریال پیش از نهایی شدن چیدمان پانل و اکسسوری‌ها انجام شود.","sipanel":"تامین بر پایه چیدمان هماهنگ و برنامه‌ریزی متریال انجام می‌شود تا کنترل پرت بهتر شود."},"installationCoordination":{"label":"هماهنگی نصب","typical":"توالی نصب و مسائل تراز ممکن است در محل پروژه حل‌وفصل شود.","sipanel":"نصب بر اساس توالی برنامه‌ریزی‌شده، نقاط کنترل تراز و جزئیات فنی هماهنگ پیش می‌رود."},"riskBeforeConstruction":{"label":"ریسک پیش از ساخت","typical":"ریسک‌های پروژه معمولاً پس از رسیدن مصالح یا شروع نصب آشکار می‌شوند.","sipanel":"ریسک‌های کلیدی پیش از تامین بررسی می‌شوند تا تصمیم‌ها زودتر کنترل شوند."},"technicalDocumentation":{"label":"مستندات فنی","typical":"مستندات ممکن است به اطلاعات محصول و راهنمای نصب پایه محدود شود.","sipanel":"شاپ‌دراوینگ، جزئیات و منطق تامین، مسئولیت‌پذیری اجرا را شفاف‌تر می‌کند."}}},"resourcesPreview":{"title":"منابع فنی برای تصمیم‌گیری بهتر پروژه","cta":"دانلود منبع مهندسی","pending":"فایل منبع در انتظار آماده‌سازی است","types":{"guide":"راهنما","checklist":"چک‌لیست"},"cards":{"panelSelection":{"title":"راهنمای انتخاب پانل","description":"نوع پانل، انتخاب هسته، ضخامت، منطق اتصال، نیاز عایق‌کاری و شرایط پروژه پیش از تامین بررسی می‌شود."},"roofLeakage":{"title":"چک‌لیست پیشگیری از نشت سقف","description":"شیب، زهکشی، فلاشینگ‌ها، نفوذی‌ها، ناودان‌ها و ریسک نصب پیش از شروع سقف کنترل می‌شود."},"shopDrawing":{"title":"راهنمای بازبینی شاپ‌دراوینگ","description":"چیدمان پانل، اکسسوری‌ها، منطق فلاشینگ، مقادیر و هماهنگی اجرا پیش از نصب بررسی می‌شود."}}},"rfq":{"eyebrow":"درخواست بررسی مهندسی","title":"پروژه خود را با اطمینان شروع کنید.","intro":"جزئیات پروژه را ارسال کنید تا SIPANEL محدوده پوسته، انتخاب سیستم، ریسک تامین و الزامات اجرا را بررسی کند.","backendPending":"اتصال بک‌اند در انتظار پیاده‌سازی است","stepsLabel":"مراحل فرم RFQ","steps":{"0":"اطلاعات تماس","1":"محدوده پروژه","2":"جزئیات فنی"},"fields":{"name":"نام و نام خانوادگی","company":"شرکت","phone":"تلفن","whatsapp":"واتساپ","email":"ایمیل","project_type":"نوع پروژه","project_location":"موقعیت پروژه","estimated_area":"مساحت تقریبی","message":"جزئیات پروژه","optional_file_upload":"آپلود نقشه یا فایل پروژه"},"projectTypes":{"sandwichPanel":"سیستم‌های ساندویچ پانل","standingSeam":"سقف Standing Seam و ZIP Tech","aluminiumCladding":"پوشش و کلادینگ آلومینیومی","fullEnvelope":"پوسته کامل صنعتی","technicalReview":"بررسی فنی / مشاوره","other":"سایر"},"placeholders":{"select":"نوع پروژه را انتخاب کنید"},"validation":{"required":"تکمیل این فیلد ضروری است.","email":"ایمیل معتبر وارد کنید.","message":"یک توضیح فنی کوتاه درباره پروژه وارد کنید.","fileSize":"حداکثر حجم فایل ۱۰ مگابایت است.","fileType":"فرمت‌های مجاز: PDF، JPG، PNG، DWG.","spam":"بررسی ضداسپم ناموفق بود."},"contact":{"title":"اطلاعات تماس SIPANEL","note":"اطلاعات تماس فقط از داده‌های تولیدی تاییدشده نمایش داده می‌شود."},"fileHelp":"اختیاری. PDF، JPG، PNG یا DWG تا ۱۰ مگابایت.","spamPlaceholder":"محافظت ضداسپم فعال است.","privacy":"جزئیات پروژه فقط برای بررسی مهندسی و پیگیری استفاده می‌شود.","back":"قبلی","next":"بع