    "rtl_and_multilingual_rules": {
      "rtl_supported": true,
      "rules": [
        "Mirror field alignment for RTL.",
        "Use logical spacing properties.",
        "Allow translated labels to expand.",
        "Preserve readable field hierarchy."
      ],
      "mixed_input_behavior": [
        "Phone numbers remain LTR.",
        "Emails remain LTR.",
        "Technical codes remain LTR."
      ],
      "contact_field_placeholder_rules": {
        "realistic_demo_values_forbidden": true,
        "phone_placeholder": "[PHONE_NUMBER]",
        "email_placeholder": "[EMAIL_ADDRESS]",
        "example_values_allowed": false,
        "rules": [
          "Phone and email fields must not use realistic demo contact values.",
          "Use neutral instructional placeholders such as 'Enter your phone number' instead of fake numbers.",
          "Production contact information must never be inferred from form placeholder examples.",
          "Phone numbers, emails, and technical codes remain LTR in RTL layouts."
        ]
      }
    },
    "conversion_optimization_rules": {
      "rules": [
        "Reduce optional fields.",
        "Place proof near RFQ forms.",
        "Keep CTA visible near form end.",
        "Avoid long intimidating forms.",
        "Use progressive steps for technical detail collection."
