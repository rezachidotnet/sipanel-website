    "accessibility_rules": {
      "requirements": [
        "All fields must have associated labels.",
        "Error messages must be screen-reader accessible.",
        "Keyboard navigation required.",
        "Focus states must remain visible.",
        "Use semantic form structure."
      ],
      "contrast_rules": [
        "Maintain WCAG AA contrast.",
        "Error and success colors must remain distinguishable."
      ]
