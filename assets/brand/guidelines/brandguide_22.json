    "page_objective": "Define the structure, behavior, accessibility, validation, and responsive interaction rules for SIPANEL forms and input components.",
    "form_philosophy": {
      "statement": "SIPANEL forms must feel fast, clear, technically professional, and frictionless for industrial users.",
      "core_principles": [
        "Reduce user effort",
        "Collect only essential information",
        "Guide completion clearly",
        "Maintain engineering professionalism",
        "Support mobile-first interaction",
        "Preserve accessibility"
      ]
    },
    "form_system_goals": [
      {
        "goal": "Reduce RFQ Friction",
        "description": "Allow users to submit project requests quickly without unnecessary complexity."
      },
      {
        "goal": "Support Technical Context",
        "description": "Enable users to provide drawings, specifications, and engineering details efficiently."
      },
      {
        "goal": "Improve Mobile Completion",
        "description": "Optimize forms for industrial users working on mobile devices."
      },
      {
        "goal": "Increase Data Accuracy",
        "description": "Use validation and structure to minimize incomplete or incorrect submissions."
      }
    ],
    "form_structure_rules": {
      "general_rules": [
        "Collect contact information first.",
        "Use one clear purpose per form.",
        "Group related fields logically.",
        "Reduce visible fields where possible.",
        "Use progressive disclosure for advanced technical details.",
        "Preserve strong visual spacing."
      ],
      "preferred_structure": [
        "Context introduction",
        "Primary project fields",
        "Optional technical details",
        "File upload",
        "Confirmation CTA"
      ]
    },
    "input_styles": {
      "text_input": {
        "height_mobile": "48px",
        "height_desktop": "52px",
        "padding": "12px 16px",
        "border_radius": "6px",
        "border": "1px solid #D9DADD",
        "background": "#FFFFFF",
        "font_size_mobile": "16px",
        "font_size_desktop": "16px"
      },
      "textarea": {
        "minimum_height": "120px",
        "resize": "vertical_only"
      },
      "select_dropdown": {
        "height_mobile": "48px",
        "height_desktop": "52px",
        "icon": "chevron-down"
      },
      "file_upload": {
        "type": "drag_and_drop + button upload",
        "supported_formats": [
          "PDF",
          "DWG",
          "JPG",
          "PNG",
          "ZIP"
        ],
        "max_file_size": "50MB"
      }
    },
    "input_states": {
      "default": {
        "border": "#D9DADD",
        "background": "#FFFFFF"
      },
      "hover": {
        "border": "#68686B"
      },
      "focus": {
        "border": "#FF6A00",
        "outline": "2px solid rgba(255,106,0,0.2)"
      },
      "error": {
        "border": "#C62828",
        "message_color": "#C62828"
      },
      "success": {
        "border": "#1E8E5A"
      },
      "disabled": {
        "opacity": "0.5",
        "background": "#F5F6F7"
      }
    },
    "label_rules": {
      "requirements": [
        "Every field must have a visible label.",
        "Labels should remain concise and clear.",
        "Do not use placeholder text as labels.",
        "Required fields must be clearly identified."
      ],
      "label_position": "top_aligned",
      "helper_text_rules": [
        "Use helper text only when necessary.",
        "Keep helper text concise.",
        "Explain technical upload requirements clearly."
      ]
    },
    "validation_rules": {
      "general_rules": [
        "Validation should happen inline when possible.",
        "Error messages must explain how to fix the issue.",
        "Avoid generic error messages.",
        "Do not clear valid fields after validation failure."
      ],
      "error_message_examples": [
        "Please enter a valid project email address.",
        "Upload must be PDF, DWG, JPG, PNG, or ZIP.",
        "Phone number format is incomplete."
      ],
