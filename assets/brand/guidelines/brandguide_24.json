{
    "page": {
      "number": 24,
      "title": "Navigation System",
      "section": "UI Component System",
      "version": "1.0",
      "brand": "SIPANEL"
    },
    "page_objective": "Define SIPANEL navigation structure, header behavior, mobile menu rules, language switching, sticky actions, accessibility, and responsive navigation patterns.",
    "navigation_philosophy": {
      "statement": "SIPANEL navigation must provide fast access to engineering proof, services, projects, resources, and conversion actions without creating complexity.",
      "core_principles": [
        "Simple structure",
        "Fast technical access",
        "Visible conversion path",
        "Mobile-first usability",
        "Clear active states",
        "Multilingual consistency"
      ]
    },
    "primary_navigation_structure": {
      "required_items": [
        "Home",
        "Systems",
        "Projects",
        "Process",
        "About",
        "Contact"
      ],
      "maximum_items": 6,
      "rules": [
        "Keep primary navigation short.",
        "Avoid deep menu nesting.",
        "Prioritize engineering and conversion pages.",
        "Use clear labels instead of marketing-style names."
      ]
    },
    "systems_navigation_structure": {
      "main_systems": [
        {
          "label": "Sandwich Panel Systems",
          "url": "/sandwich-panel-systems"
        },
        {
          "label": "ZIP Tech / Standing Seam Roofing",
          "url": "/zip-tech-standing-seam-roofing"
        },
        {
          "label": "Aluminium Cladding & Covering",
          "url": "/aluminium-cladding-covering"
        }
      ],
      "rules": [
        "Systems menu must represent all core SIPANEL service categories.",
        "Do not position SIPANEL as a sandwich-panel-only company.",
        "Use Systems as the parent navigation label instead of Products.",
        "Keep top-level navigation short and expose service categories inside Systems dropdown or drawer."
      ]
    },
    "header_layout": {
      "desktop": {
        "layout": "logo_left_menu_center_cta_language_right",
        "height": "80px-88px",
        "behavior": "sticky_on_scroll"
      },
      "tablet": {
        "layout": "logo_left_compact_menu_cta_right",
        "behavior": "adaptive_collapsed_navigation"
      },
      "mobile": {
        "layout": "logo_left_menu_icon_right",
        "behavior": "sticky_header_with_bottom_cta"
      }
    },
    "sticky_behavior": {
      "enabled": true,
      "rules": [
        "Header remains visible during scroll.",
        "Background may become solid after scroll.",
        "Use subtle shadow only when needed.",
        "Do not reduce logo clarity.",
        "Avoid blocking important content."
      ]
    },
    "mobile_navigation": {
      "menu_type": "slide_panel_or_fullscreen_drawer",
      "rules": [
        "Large touch targets required.",
        "Language selector appears near top.",
        "Primary CTA remains visible.",
        "Navigation depth should remain shallow.",
        "Close menu after navigation selection."
      ],
      "minimum_touch_target": "48px"
    },
    "language_switcher": {
      "enabled": true,
      "supported_languages": [
        {
          "code": "en",
          "label": "EN",
          "direction": "ltr"
        },
        {
          "code": "fa",
          "label": "FA",
          "direction": "rtl"
        },
        {
          "code": "ar",
          "label": "AR",
          "direction": "rtl"
        },
        {
          "code": "ru",
          "label": "RU",
          "direction": "ltr"
        }
      ],
      "desktop_behavior": "inline_tabs_or_dropdown",
      "mobile_behavior": "inside_mobile_menu_top",
      "rules": [
        "Persist selected language.",
        "Update HTML lang attribute.",
        "Update HTML dir attribute.",
        "Preserve current route when switching language.",
        "Avoid flag-only selectors."
      ]
    },
    "active_state_rules": {
      "desktop": [
        "Use orange accent for active navigation item.",
        "Avoid heavy underline decoration.",
        "Maintain readable contrast."
      ],
      "mobile": [
        "Show clear active item state.",
        "Use background or border accent.",
        "Do not rely on color alone."
      ]
    },
    "cta_navigation_rules": {
      "primary_header_cta": "Get Free Engineering Review",
      "mobile_sticky_cta": "Free Engineering Review",
      "secondary_mobile_actions": [
        "Call",
        "WhatsApp"
      ],
      "rules": [
        "Primary CTA must remain accessible from navigation.",
        "CTA should not compete with menu readability.",
        "Use engineering-first CTA language."
      ]
    },
    "contact_data_rules": {
      "source_of_truth": "production_contact_config",
      "hardcoded_contact_values_forbidden": true,
      "allowed_placeholders": [
        "[PHONE_NUMBER]",
        "[WHATSAPP_NUMBER]",
        "[EMAIL_ADDRESS]"
      ],
      "rules": [
        "Do not use realistic demo phone numbers in navigation examples.",
        "Do not copy phone numbers from mockup images into production UI.",
        "Header, mobile drawer, sticky CTA, footer, and contact buttons must read contact data only from production_contact_config.",
        "If production contact data is missing, display CTA labels only, not fake numbers."
      ],
      "fallback_labels": {
        "phone": "Call Us",
        "whatsapp": "WhatsApp",
        "email": "Email Us"
      }
    },
    "technical_quick_access": {
      "enabled": true,
      "recommended_items": [
