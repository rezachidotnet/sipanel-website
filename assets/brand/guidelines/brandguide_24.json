        "Case studies",
        "Resource pages",
        "Blog articles"
      ],
      "rules": [
        "Use semantic breadcrumb markup.",
        "Keep hierarchy short.",
        "Support RTL direction."
      ]
    },
    "footer_navigation": {
      "required_sections": [
        "Company",
        "Services",
        "Resources",
        "Contact"
      ],
      "rules": [
        "Repeat important links.",
        "Use dark background preferred.",
        "Keep footer clean and structured.",
        "Include contact details clearly."
      ]
    },
    "accessibility_rules": {
      "requirements": [
        "Navigation must use semantic HTML.",
        "Mobile menu must be keyboard accessible.",
        "Focus states required.",
        "Menu open and close states must be announced.",
        "Skip link to main content recommended."
      ]
    },
    "rtl_and_multilingual_rules": {
      "rtl_supported": true,
      "rules": [
        "Mirror navigation alignment in RTL.",
        "Flip directional icons.",
        "Use logical spacing properties.",
        "Preserve menu order clarity across languages."
      ]
